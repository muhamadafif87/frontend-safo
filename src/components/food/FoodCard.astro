---
// FoodCard.astro — Kartu makanan surplus
// Shadow hanya saat hover/focus — BUKAN shadow diam permanen
// Badge diskon: bentuk "tiket sobek", foto makanan dominan

interface Props {
  id: string;
  name: string;
  store: string;
  category: string;
  description?: string;
  price: number;
  originalPrice: number;
  discount: number;
  distance: number;
  pickupLabel: string;
  pickupStart?: string;
  pickupEnd?: string;
  available?: number;
  rating?: number;
  image: string;
  featured?: boolean;
  compact?: boolean; // variant lebih kecil untuk listing
}

const {
  id,
  name,
  store,
  category,
  description,
  price,
  originalPrice,
  discount,
  distance,
  pickupLabel,
  pickupStart = '',
  pickupEnd = '',
  available = 0,
  rating,
  image,
  featured = false,
  compact = false,
} = Astro.props;

// Format harga ke Rupiah
function formatRp(num: number) {
  return `Rp ${num.toLocaleString('id-ID')}`;
}

const isLowStock = available > 0 && available <= 3;
---

<article
  class={`food-card ${compact ? 'food-card--compact' : ''} ${featured ? 'food-card--featured' : ''}`}
  data-id={id}
  data-category={category}
  data-price={price}
  data-distance={distance}
  data-discount={discount}
  data-pickup-start={pickupStart}
  data-pickup-end={pickupEnd}
>
  <!-- Gambar makanan — elemen dominan -->
  <div class="food-card__image-wrap">
    <a href={`/food/${id}`} class="food-card__image-link" aria-label={`Lihat detail ${name} dari ${store}`}>
      <img
        src={image}
        alt={`${name} dari ${store}`}
        class="food-card__image"
        loading="lazy"
        width="400"
        height="260"
      />
    </a>

    <!-- Badge diskon (tiket sobek) -->
    <div class="food-card__badge" aria-label={`Diskon ${discount}%`}>
      <span class="food-card__badge-text">-{discount}%</span>
    </div>

    <!-- Tombol favorit -->
    <button
      class="food-card__fav"
      type="button"
      aria-label={`Tambah ${name} ke favorit`}
      aria-pressed="false"
      data-food-name={name}
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path
          class="food-card__fav-icon"
          d="M9 15.25s-7-4.5-7-9a4.5 4.5 0 018.28-2.48A4.5 4.5 0 0116 6.25c0 4.5-7 9-7 9z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>

  <!-- Konten kartu -->
  <div class="food-card__body">
    <!-- Store + kategori -->
    <div class="food-card__meta">
      <span class="food-card__store">{store}</span>
      {isLowStock && (
        <span class="food-card__stock" aria-label={`Sisa ${available} porsi`}>
          Sisa {available}
        </span>
      )}
    </div>

    <!-- Nama makanan -->
    <h3 class="food-card__name">
      <a href={`/food/${id}`}>{name}</a>
    </h3>

    <!-- Harga -->
    <div class="food-card__price-row">
      <span class="food-card__price">{formatRp(price)}</span>
      <span class="food-card__original-price" aria-label={`Harga normal ${formatRp(originalPrice)}`}>
        {formatRp(originalPrice)}
      </span>
    </div>

    <!-- Info jarak & pickup -->
    <div class="food-card__info">
      <span class="food-card__distance" aria-label={`Jarak ${distance} km`}>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M6 1C4.07 1 2.5 2.57 2.5 4.5 2.5 7.375 6 11 6 11s3.5-3.625 3.5-6.5C9.5 2.57 7.93 1 6 1z" stroke="currentColor" stroke-width="1"/>
          <circle cx="6" cy="4.5" r="1" stroke="currentColor" stroke-width="1"/>
        </svg>
        {distance} km
      </span>
      <span class="food-card__separator" aria-hidden="true">·</span>
      <span class="food-card__pickup" aria-label={`Waktu pickup ${pickupLabel}`}>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1"/>
          <path d="M6 3.5v2.75l1.5 1" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        </svg>
        {pickupLabel}
      </span>
    </div>
  </div>
</article>

<style>
  /* -------- Card base -------- */
  .food-card {
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    /* TIDAK ada shadow diam — hanya muncul saat hover/focus */
    transition:
      box-shadow var(--motion-base) var(--easing-standard),
      transform var(--motion-base) var(--easing-standard),
      border-color var(--motion-base) var(--easing-standard);
    display: flex;
    flex-direction: column;
  }

  .food-card:hover,
  .food-card:focus-within {
    box-shadow: var(--shadow-interactive);
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
  }

  /* -------- Image wrap -------- */
  .food-card__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-border);
  }

  .food-card--compact .food-card__image-wrap {
    aspect-ratio: 16 / 9;
  }

  .food-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .food-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--easing-standard);
  }

  .food-card:hover .food-card__image {
    transform: scale(1.03);
  }

  /* -------- Badge diskon (tiket sobek) -------- */
  .food-card__badge {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--color-accent-strong);
    color: #fff;
    /* Clip path: sudut kanan bawah dipotong — efek tiket */
    clip-path: polygon(0 0, 100% 0, 100% 55%, 75% 100%, 0 100%);
    padding: var(--space-2) var(--space-3) var(--space-3) var(--space-2);
    min-width: 56px;
    z-index: 2;
  }

  /* Lubang kecil untuk efek tiket sobek */
  .food-card__badge::after {
    content: '';
    position: absolute;
    right: 2px;
    bottom: 8px;
    width: 8px;
    height: 8px;
    background: var(--color-bg-alt);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--color-accent-strong);
  }

  .food-card__badge-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    display: block;
  }

  /* -------- Tombol favorit -------- */
  .food-card__fav {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(4px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-muted);
    transition:
      color var(--motion-fast) var(--easing-standard),
      transform var(--motion-fast) var(--easing-standard),
      background-color var(--motion-fast) var(--easing-standard);
  }

  .food-card__fav:hover {
    color: var(--color-accent-strong);
    transform: scale(1.1);
  }

  .food-card__fav[aria-pressed="true"] {
    color: var(--color-accent-strong);
  }

  .food-card__fav[aria-pressed="true"] .food-card__fav-icon {
    fill: var(--color-accent-strong);
    stroke: var(--color-accent-strong);
  }

  /* -------- Body -------- */
  .food-card__body {
    padding: var(--space-3) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  /* Meta: nama toko + stok */
  .food-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 24px; /* sama tinggi dengan baris yang punya badge "Sisa" */
  }

  .food-card__store {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .food-card__stock {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-strong);
    background: var(--color-accent-light);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Nama makanan */
  .food-card__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
    line-height: var(--leading-snug);
  }

  .food-card__name a {
    text-decoration: none;
    color: inherit;
  }

  .food-card__name a:hover {
    color: var(--color-primary-700);
  }

  /* Harga */
  .food-card__price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .food-card__price {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-700);
  }

  .food-card__original-price {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-decoration: line-through;
  }

  /* Info jarak & pickup */
  .food-card__info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    flex-wrap: wrap;
  }

  .food-card__distance,
  .food-card__pickup {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .food-card__separator {
    color: var(--color-border-strong);
  }
</style>

<script>
  // Tombol favorit — trigger Toast + toggle state
  document.querySelectorAll('.food-card__fav').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const button = btn as HTMLButtonElement;
      const isPressed = button.getAttribute('aria-pressed') === 'true';
      const foodName = button.dataset.foodName ?? 'Makanan';

      button.setAttribute('aria-pressed', String(!isPressed));

      if (!isPressed) {
        // Tambah ke favorit
        button.setAttribute('aria-label', `Hapus ${foodName} dari favorit`);
        (window as any).showToast?.(`${foodName} ditambahkan ke favorit ❤️`, 'success');
      } else {
        // Hapus dari favorit
        button.setAttribute('aria-label', `Tambah ${foodName} ke favorit`);
        (window as any).showToast?.(`${foodName} dihapus dari favorit`, 'info');
      }
    });
  });
</script>
