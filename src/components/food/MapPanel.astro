---
// MapPanel.astro — Peta statis placeholder dengan pin dummy Surakarta
// Desktop: sticky di kanan, Tablet: di atas, Mobile: toggle bottom sheet

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Pin dummy — posisi hardcoded sesuai wireframe (kawasan Surakarta/UNS)
const pins = [
  { id: 'warung-pak-budi', label: 'Warung Pak Budi', x: 54, y: 38, selected: true, discount: 50 },
  { id: 'sofiro-bakery', label: 'Sofiro Bakery', x: 34, y: 28, selected: false, discount: 40 },
  { id: 'fresh-juice', label: 'Fresh Juice & Salad', x: 62, y: 58, selected: false, discount: 48 },
  { id: 'tofu-express', label: 'Tofu Express', x: 68, y: 32, selected: false, discount: 44 },
  { id: 'kopi-nusantara', label: 'Kopi Nusantara', x: 46, y: 50, selected: false, discount: 56 },
  { id: 'dz-donat', label: 'DZ Donat', x: 28, y: 62, selected: false, discount: 62 },
];
---

<div class={`map-panel ${className}`} id="map-panel">
  <!-- Map area -->
  <div class="map-panel__map" role="img" aria-label="Peta area Surakarta menampilkan lokasi merchant SAFO">

    <!-- Tile peta bergaya SAFO (SVG representatif, bukan tile sungguhan) -->
    <svg
      class="map-panel__tile"
      viewBox="0 0 400 300"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
    >
      <!-- Background -->
      <rect width="400" height="300" fill="#e8f0e9"/>

      <!-- Jalan utama (Solo - UNS) -->
      <path d="M0 150 Q100 145 200 155 Q300 165 400 158" stroke="#fff" stroke-width="8" fill="none"/>
      <path d="M0 150 Q100 145 200 155 Q300 165 400 158" stroke="#d4dbd4" stroke-width="6" fill="none"/>

      <!-- Jalan vertikal (Jl. Ir. Sutami) -->
      <path d="M200 0 Q205 80 198 150 Q192 220 200 300" stroke="#fff" stroke-width="7" fill="none"/>
      <path d="M200 0 Q205 80 198 150 Q192 220 200 300" stroke="#d4dbd4" stroke-width="5" fill="none"/>

      <!-- Jalan secondary -->
      <path d="M0 80 Q80 78 160 82" stroke="#e5e9e5" stroke-width="4" fill="none"/>
      <path d="M240 80 Q310 76 400 82" stroke="#e5e9e5" stroke-width="4" fill="none"/>
      <path d="M280 0 Q282 100 285 200" stroke="#e5e9e5" stroke-width="4" fill="none"/>
      <path d="M100 200 Q200 195 300 205" stroke="#e5e9e5" stroke-width="4" fill="none"/>
      <path d="M0 230 Q80 225 140 230" stroke="#e5e9e5" stroke-width="3" fill="none"/>
      <path d="M320 230 Q370 225 400 228" stroke="#e5e9e5" stroke-width="3" fill="none"/>

      <!-- Blok kota / bangunan -->
      <rect x="20" y="20" width="70" height="50" rx="3" fill="#d8e6d9" opacity="0.6"/>
      <rect x="110" y="20" width="50" height="40" rx="3" fill="#d0ddd0" opacity="0.5"/>
      <rect x="310" y="20" width="60" height="45" rx="3" fill="#d8e6d9" opacity="0.6"/>
      <rect x="20" y="170" width="80" height="60" rx="3" fill="#d0ddd0" opacity="0.5"/>
      <rect x="300" y="170" width="75" height="70" rx="3" fill="#d8e6d9" opacity="0.6"/>
      <rect x="220" y="20" width="45" height="35" rx="3" fill="#d0ddd0" opacity="0.5"/>

      <!-- Sungai Bengawan Solo (representatif) -->
      <path d="M350 280 Q300 250 250 270 Q200 290 150 265 Q100 240 50 260" stroke="#aac8d4" stroke-width="14" fill="none" stroke-linecap="round"/>
      <path d="M350 280 Q300 250 250 270 Q200 290 150 265 Q100 240 50 260" stroke="#c0d8e4" stroke-width="10" fill="none" stroke-linecap="round"/>

      <!-- Label kota (tidak memakai tracked caps) -->
      <text x="200" y="130" text-anchor="middle" font-size="11" font-family="sans-serif" fill="#5c6b67" font-weight="500" opacity="0.8">Universitas Sebelas Maret</text>
      <text x="60" y="100" text-anchor="middle" font-size="9" font-family="sans-serif" fill="#7a8a86" opacity="0.7">Laweyan</text>
      <text x="320" y="110" text-anchor="middle" font-size="9" font-family="sans-serif" fill="#7a8a86" opacity="0.7">Surakarta</text>
      <text x="70" y="240" text-anchor="middle" font-size="9" font-family="sans-serif" fill="#7a8a86" opacity="0.7">Kadipiro</text>
      <text x="350" y="240" text-anchor="middle" font-size="9" font-family="sans-serif" fill="#7a8a86" opacity="0.7">Mojosongo</text>

      <!-- Overlay brand ringan -->
      <rect width="400" height="300" fill="url(#brand-overlay)" opacity="0.08"/>
      <defs>
        <linearGradient id="brand-overlay" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#12403a"/>
          <stop offset="100%" stop-color="#2f7a5c"/>
        </linearGradient>
      </defs>
    </svg>

    <!-- Pin merchant dummy -->
    {pins.map((pin) => (
      <button
        class={`map-panel__pin ${pin.selected ? 'map-panel__pin--selected' : ''}`}
        style={`left: ${pin.x}%; top: ${pin.y}%;`}
        aria-label={`${pin.label}, diskon ${pin.discount}%`}
        data-merchant={pin.id}
        type="button"
      >
        {pin.selected ? (
          <span class="map-panel__pin-bubble">
            <span class="map-panel__pin-discount">-{pin.discount}%</span>
            <span class="map-panel__pin-name">{pin.label}</span>
          </span>
        ) : (
          <svg width="20" height="24" viewBox="0 0 20 24" fill="none" aria-hidden="true">
            <path d="M10 0C4.477 0 0 4.477 0 10c0 7.5 10 14 10 14S20 17.5 20 10C20 4.477 15.523 0 10 0z" fill="var(--color-primary-700)"/>
            <circle cx="10" cy="10" r="3.5" fill="#fff"/>
          </svg>
        )}
      </button>
    ))}

    <!-- Kontrol zoom (UI saja, tidak fungsional) -->
    <div class="map-panel__controls" aria-hidden="true">
      <button class="map-panel__zoom" type="button" tabindex="-1" aria-hidden="true">+</button>
      <button class="map-panel__zoom" type="button" tabindex="-1" aria-hidden="true">−</button>
    </div>

    <!-- Watermark peta -->
    <div class="map-panel__watermark" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <circle cx="14" cy="14" r="14" fill="var(--color-primary-700)" opacity="0.3"/>
      </svg>
      <span>SAFO Maps</span>
    </div>
  </div>
</div>

<!-- Mobile toggle button (di luar map-panel, dirender oleh halaman) -->

<style>
  /* -------- Panel -------- */
  .map-panel {
    width: 100%;
    background: var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-rest);
    position: relative;
  }

  /* -------- Map container -------- */
  .map-panel__map {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .map-panel__map {
      aspect-ratio: unset;
      height: 100%;
      min-height: 480px;
    }
  }

  .map-panel__tile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* -------- Pin merchant -------- */
  .map-panel__pin {
    position: absolute;
    transform: translate(-50%, -100%);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
    transition: transform var(--motion-fast) var(--easing-standard);
  }

  .map-panel__pin:hover,
  .map-panel__pin:focus-visible {
    transform: translate(-50%, -100%) scale(1.15);
    z-index: 10;
  }

  .map-panel__pin:focus-visible {
    outline: 2px solid var(--color-primary-700);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }

  /* Pin terpilih — bubble dengan nama */
  .map-panel__pin--selected {
    z-index: 5;
  }

  .map-panel__pin-bubble {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-primary-700);
    color: #fff;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    gap: 2px;
    box-shadow: var(--shadow-interactive);
    position: relative;
  }

  /* Arrow down dari bubble */
  .map-panel__pin-bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--color-primary-700);
    border-bottom: 0;
  }

  .map-panel__pin-discount {
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-body);
    line-height: 1;
    color: var(--color-accent);
  }

  .map-panel__pin-name {
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-body);
    white-space: nowrap;
    line-height: 1;
  }

  /* -------- Controls -------- */
  .map-panel__controls {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 3;
  }

  .map-panel__zoom {
    width: 30px;
    height: 30px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-size: 18px;
    line-height: 1;
    color: var(--color-ink-muted);
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    box-shadow: var(--shadow-rest);
  }

  /* -------- Watermark -------- */
  .map-panel__watermark {
    position: absolute;
    bottom: var(--space-2);
    left: var(--space-3);
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    background: rgb(255 255 255 / 0.8);
    padding: 2px var(--space-2);
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    z-index: 3;
  }
</style>
