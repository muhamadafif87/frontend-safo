---
// MapPanel.astro — Peta interaktif Leaflet + OpenStreetMap
// Desktop: sticky di kanan, Mobile: dipakai di dalam bottom sheet.
// Data titik mitra: src/data/partners.json (dummy, nanti diganti API).

import partners from '../../data/partners.json';
import categories from '../../data/categories.json';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const categoryLabels: Record<string, string> = Object.fromEntries(
  categories.map((c) => [c.id, c.label])
);

const data = partners.map((p) => ({
  ...p,
  categoryLabel: categoryLabels[p.category] ?? 'Lainnya',
}));
---

<div class={`map-panel ${className}`} data-map data-partners={JSON.stringify(data)}>
  <div
    class="map-panel__map"
    role="region"
    aria-label="Peta lokasi mitra SAFO di sekitar Surakarta"
  ></div>
</div>

<style>
  .map-panel {
    width: 100%;
    background: var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-rest);
    position: relative;
  }

  .map-panel__map {
    position: relative;
    z-index: 0; /* kurung stacking context Leaflet agar tidak menimpa header/modal */
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #e8f0e9;
  }

  @media (min-width: 1024px) {
    .map-panel__map {
      aspect-ratio: unset;
      height: 100%;
      min-height: 480px;
    }
  }
</style>

<!-- Style untuk elemen yang dibuat Leaflet (di luar scope Astro) -->
<style is:global>
  .map-panel .leaflet-container {
    font-family: var(--font-body);
  }

  /* ---------- Pin ---------- */
  .safo-pin {
    background: none;
    border: 0;
  }

  .safo-pin__inner {
    display: block;
    width: 28px;
    height: 34px;
    transform-origin: 50% 100%;
    filter: drop-shadow(0 2px 3px rgb(11 46 42 / 0.3));
    transition: transform var(--motion-fast) var(--easing-standard);
  }

  .safo-pin:hover .safo-pin__inner,
  .safo-pin:focus-visible .safo-pin__inner {
    transform: scale(1.18);
  }

  .safo-pin:focus-visible {
    outline: none;
  }

  .safo-pin:focus-visible .safo-pin__inner {
    filter: drop-shadow(0 0 0 var(--color-primary-700)) drop-shadow(0 0 3px var(--color-primary-500));
  }

  /* ---------- Popup ---------- */
  .safo-popup .leaflet-popup-content-wrapper {
    background: var(--color-bg-alt);
    color: var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-interactive);
    /* Padding di sini (bukan margin di isi), karena margin vertikal isi popup runtuh keluar kartu */
    padding: var(--space-5) var(--space-10) var(--space-5) var(--space-5);
  }

  .safo-popup .leaflet-popup-content {
    margin: 0;
    font-family: var(--font-body);
    line-height: var(--leading-snug);
  }

  .safo-popup .leaflet-popup-tip {
    background: var(--color-bg-alt);
    box-shadow: none;
  }

  .safo-popup a.leaflet-popup-close-button {
    top: var(--space-3);
    right: var(--space-3);
    width: 22px;
    height: 22px;
    font-size: 20px;
    line-height: 22px;
    color: var(--color-ink-muted);
  }

  .safo-popup a.leaflet-popup-close-button:hover {
    color: var(--color-ink);
  }

  .safo-popup__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .safo-popup__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-900);
  }

  .safo-popup__badge {
    display: inline-block;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-primary-700);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
  }

  .safo-popup .safo-popup__category {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary-500);
  }

  .safo-popup .safo-popup__address {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .safo-popup__address svg {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 1px;
    color: var(--color-ink-muted);
  }

  /* ---------- Kontrol ---------- */
  .map-panel .leaflet-bar a {
    color: var(--color-ink-muted);
  }

  .map-panel .leaflet-control-attribution {
    font-size: 10px;
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Partner {
    id: string;
    foodId?: string;
    name: string;
    category: string;
    categoryLabel: string;
    discount: number;
    address: string;
    lat: number;
    lng: number;
  }

  interface FilterDetail {
    visibleIds: string[];
    price: string;
    distance: string;
    category: string;
    pickup: string;
    search: string;
  }

  const TILE_URL = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
  const TILE_ATTRIBUTION =
    '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>';

  const PIN_SVG = `
    <span class="safo-pin__inner">
      <svg width="28" height="34" viewBox="0 0 20 24" fill="none" aria-hidden="true">
        <path d="M10 0C4.477 0 0 4.477 0 10c0 7.5 10 14 10 14S20 17.5 20 10C20 4.477 15.523 0 10 0z" fill="#12403a"/>
        <circle cx="10" cy="10" r="3.5" fill="#fff"/>
      </svg>
    </span>`;

  const ADDRESS_ICON = `
    <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M10 18s6-5.2 6-9.5a6 6 0 10-12 0C4 12.8 10 18 10 18z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="10" cy="8.5" r="2" stroke="currentColor" stroke-width="1.5"/>
    </svg>`;

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function popupHtml(p: Partner): string {
    return `
      <div class="safo-popup__head">
        <h3 class="safo-popup__title">${escapeHtml(p.name)}</h3>
        <span class="safo-popup__badge">-${p.discount}%</span>
      </div>
      <p class="safo-popup__category">${escapeHtml(p.categoryLabel)}</p>
      <p class="safo-popup__address">${ADDRESS_ICON}<span>${escapeHtml(p.address)}</span></p>`;
  }

  function initMap(container: HTMLElement, partners: Partner[]): L.Map & { refit?: () => void } {
    const canHover = window.matchMedia('(hover: hover)').matches;

    const map: L.Map & { refit?: () => void } = L.map(container, {
      zoomControl: false,
      scrollWheelZoom: false, // supaya scroll halaman tidak "tertelan" peta
    });

    L.control.zoom({ position: 'topright' }).addTo(map);
    map.attributionControl.setPrefix(false);

    L.tileLayer(TILE_URL, { maxZoom: 19, attribution: TILE_ATTRIBUTION }).addTo(map);

    // Scroll-zoom hanya aktif setelah peta diklik, mati lagi saat kursor keluar
    map.on('click focus', () => map.scrollWheelZoom.enable());
    map.on('mouseout blur', () => map.scrollWheelZoom.disable());

    const layer = L.layerGroup().addTo(map);
    const items: { partner: Partner; marker: L.Marker }[] = [];
    let pinned: L.Popup | null = null; // popup yang dikunci lewat klik/tap

    partners.forEach((partner) => {
      const marker = L.marker([partner.lat, partner.lng], {
        icon: L.divIcon({
          className: 'safo-pin',
          html: PIN_SVG,
          iconSize: [28, 34],
          iconAnchor: [14, 34],
        }),
        alt: `${partner.name}, diskon ${partner.discount}%`,
        riseOnHover: true,
      });

      const popup = L.popup({
        className: 'safo-popup',
        offset: [0, -30],
        minWidth: 230,
        maxWidth: 300,
        autoPanPadding: [24, 24],
        closeButton: true,
      }).setContent(popupHtml(partner));

      // autoPan: peta hanya bergeser saat popup dikunci lewat klik, bukan saat sekadar hover
      const open = (autoPan: boolean) => {
        popup.options.autoPan = autoPan;
        popup.setLatLng(marker.getLatLng()).openOn(map);
      };

      // Desktop: tampil saat kursor di atas titik (kecuali ada popup yang dikunci)
      marker.on('mouseover', () => {
        if (canHover && !pinned) open(false);
      });
      marker.on('mouseout', () => {
        if (canHover && pinned !== popup) map.closePopup(popup);
      });
      // Klik / sentuh / Enter: kunci popup supaya tidak hilang saat kursor pindah
      marker.on('click', () => {
        pinned = popup;
        open(true);
      });

      layer.addLayer(marker);
      items.push({ partner, marker });
    });

    map.on('popupclose', (e) => {
      if (pinned === e.popup) pinned = null;
    });

    // Pas-kan tampilan ke titik yang terlihat. Selama pengguna belum menggeser/zoom sendiri,
    // tampilan di-fit ulang saat ukuran container berubah (mis. layout baru selesai dihitung).
    let fitting = false;
    let userMoved = false;

    map.on('movestart zoomstart', () => {
      if (!fitting) userMoved = true;
    });

    const fit = (animate = false) => {
      const points = items
        .filter(({ marker }) => layer.hasLayer(marker))
        .map(({ partner }) => [partner.lat, partner.lng] as [number, number]);
      if (points.length === 0) return;
      fitting = true;
      map.fitBounds(L.latLngBounds(points), { padding: [48, 48], maxZoom: 16, animate });
      fitting = false;
    };

    fit();
    map.refit = () => {
      if (!userMoved) fit();
    };

    // Sinkron dengan filter daftar makanan (event dikirim dari index.astro)
    const applyFilter = (d: FilterDetail) => {
      const neutral =
        d.price === 'all' && d.distance === 'all' && d.pickup === 'all' && !d.search;

      map.closePopup();
      items.forEach(({ partner, marker }) => {
        const show = partner.foodId
          ? d.visibleIds.includes(partner.foodId)
          : neutral && (d.category === 'all' || d.category === partner.category);
        if (show) layer.addLayer(marker);
        else layer.removeLayer(marker);
      });
      userMoved = false;
      fit(true);
    };

    window.addEventListener('safo:filter', (event) =>
      applyFilter((event as CustomEvent<FilterDetail>).detail)
    );

    // Filter yang sudah aktif sebelum peta selesai dibuat (mis. dibuka lewat /?q=...)
    const initial = (window as any).__safoFilter as FilterDetail | undefined;
    if (initial) applyFilter(initial);

    return map;
  }

  // Peta dibuat saat container sudah punya ukuran (panel desktop disembunyikan di mobile),
  // dan ukurannya dihitung ulang otomatis kalau container berubah.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((panel) => {
    const container = panel.querySelector<HTMLElement>('.map-panel__map');
    if (!container) return;

    const partners: Partner[] = JSON.parse(panel.dataset.partners ?? '[]');
    let map: (L.Map & { refit?: () => void }) | null = null;

    new ResizeObserver(() => {
      const ready = container.clientWidth >= 120 && container.clientHeight >= 120;
      if (!map) {
        if (ready) map = initMap(container, partners);
      } else {
        map.invalidateSize();
        map.refit?.();
      }
    }).observe(container);
  });
</script>
