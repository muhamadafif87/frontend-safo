---
import Button from "../ui/Button.astro";
import Modal from "../ui/Modal.astro";

// Header.astro — Navigasi utama SAFO
// Nav links, dropdown About (desktop), hamburger + drawer (mobile)

const navLinks = [
  { href: '/food-nearby', label: 'Food Nearby', id: 'food-nearby' },
  { href: '/how-it-works', label: 'How It Works', id: 'how-it-works' },
  { href: '/impact', label: 'Impact', id: 'impact' },
  { href: '/for-business', label: 'For Business', id: 'for-business' },
];

const aboutLinks = [
  { href: '/about#misi', label: 'Misi Kami' },
  { href: '/about#tim', label: 'Tim' },
  { href: '/about#karier', label: 'Karier' },
  { href: '/about#kontak', label: 'Kontak' },
];

// Data untuk saran pencarian di top bar
import foods from '../../data/foods.json';
const searchItems = foods.map((f) => ({ name: f.name, store: f.store, price: f.price }));

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/food-nearby' && currentPath === '/') return true;
  return currentPath.startsWith(href);
}
---

<header class="header" role="banner">
  <div class="container header__inner">
    <!-- Logo -->
    <a href="/" class="header__logo" aria-label="SAFO — Kembali ke halaman utama">
      <img src="/favicon.svg" alt="SAFO logo" />
      <span class="header__logo-text">SAFO</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Navigasi utama">
      <ul class="header__nav-list" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`header__nav-link ${isActive(link.href) ? 'is-active' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}

        <!-- About dropdown -->
        <li class="header__nav-item--dropdown">
          <button
            class={`header__nav-link header__dropdown-trigger ${isActive('/about') ? 'is-active' : ''}`}
            aria-expanded="false"
            aria-haspopup="true"
            id="about-trigger"
          >
            About
            <svg class="header__dropdown-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="header__dropdown" role="menu" aria-labelledby="about-trigger" id="about-dropdown">
            <ul class="header__dropdown-list" role="list">
              {aboutLinks.map((link) => (
                <li>
                  <a href={link.href} class="header__dropdown-link" role="menuitem">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <!-- Right actions -->
    <div class="header__actions">
      <button
        class="header__search-btn"
        id="search-btn"
        type="button"
        aria-label="Cari makanan"
        aria-expanded="false"
        aria-controls="search-panel"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      <a href="/" class="header__cta-btn" aria-label="Download aplikasi SAFO">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2v8M8 10l-2.5-2.5M8 10l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Download App
      </a>

      <!-- Modal Login -->
      <Modal id="main-login-modal">
        <span slot="trigger">Masuk</span>
      </Modal>

      <!-- Hamburger (mobile only) -->
      <button
        class="header__hamburger"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        id="hamburger-btn"
      >
        <span class="header__hamburger-bar"></span>
        <span class="header__hamburger-bar"></span>
        <span class="header__hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Panel pencarian (desktop/tablet) -->
  <div class="header__search-panel" id="search-panel" data-items={JSON.stringify(searchItems)} hidden>
    <div class="container">
      <form class="header__search-form" role="search" action="/#listing" method="get" id="header-search-form">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          name="q"
          id="header-search-input"
          class="header__search-input"
          placeholder="Cari makanan atau toko..."
          aria-label="Cari makanan atau toko"
          aria-controls="search-suggestions"
          autocomplete="off"
        />
        <button type="submit" class="header__search-submit">Cari</button>
        <button type="button" class="header__search-close" id="search-close" aria-label="Tutup pencarian">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </form>
      <ul class="header__search-results" id="search-suggestions" role="listbox" aria-label="Saran pencarian" hidden></ul>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    class="header__drawer"
    id="mobile-drawer"
    aria-hidden="true"
    role="dialog"
    aria-label="Menu navigasi"
    aria-modal="true"
  >
    <nav aria-label="Navigasi mobile">
      <form class="header__drawer-search" role="search" action="/#listing" method="get">
        <input type="search" name="q" placeholder="Cari makanan atau toko..." aria-label="Cari makanan atau toko" />
        <button type="submit" aria-label="Cari">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </form>
      <ul class="header__drawer-list" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`header__drawer-link ${isActive(link.href) ? 'is-active' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}

        <!-- About accordion (mobile) -->
        <li class="header__drawer-accordion">
          <button
            class="header__drawer-link header__drawer-accordion-trigger"
            aria-expanded="false"
            id="mobile-about-trigger"
          >
            About
            <svg class="header__dropdown-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="header__drawer-submenu" id="mobile-about-submenu" role="list">
            {aboutLinks.map((link) => (
              <li>
                <a href={link.href} class="header__drawer-sublink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
      </ul>

      <div class="header__drawer-footer">
        <a href="/" class="header__cta-btn header__cta-btn--full">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v8M8 10l-2.5-2.5M8 10l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Download App
        </a>
      </div>
    </nav>
  </div>

  <!-- Overlay backdrop (mobile) -->
  <div class="header__overlay" id="drawer-overlay" aria-hidden="true"></div>
</header>

<style>
  /* -------- Header container -------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 100%;
  }

  /* -------- Logo -------- */
  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    text-decoration: none;
  }

  .header__logo img{
    width: 40px;
    height: auto;
  }

  .header__logo-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-700);
    letter-spacing: var(--tracking-tight);
  }

  /* -------- Desktop Nav -------- */
  .header__nav {
    flex: 1;
    display: none;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
  }

  .header__nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    cursor: pointer;
    transition:
      color var(--motion-fast) var(--easing-standard),
      background-color var(--motion-fast) var(--easing-standard);
    position: relative;
    white-space: nowrap;
  }

  @media (min-width: 1024px) and (max-width: 1179px) {
    .header__nav-link {
      padding-inline: var(--space-2);
    }

    .header__inner {
      gap: var(--space-4);
    }
  }

  .header__nav-link:hover {
    color: var(--color-primary-700);
    background-color: var(--color-primary-100);
  }

  .header__nav-link.is-active {
    color: var(--color-primary-700);
    font-weight: var(--font-weight-semibold);
  }

  /* Underline aktif */
  .header__nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: var(--space-3);
    right: var(--space-3);
    height: 2px;
    background: var(--color-primary-700);
    border-radius: var(--radius-pill);
  }

  /* -------- Dropdown About -------- */
  .header__nav-item--dropdown {
    position: relative;
  }

  .header__dropdown-icon {
    transition: transform var(--motion-fast) var(--easing-standard);
  }

  .header__dropdown-trigger[aria-expanded="true"] .header__dropdown-icon {
    transform: rotate(180deg);
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    min-width: 160px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-interactive);
    padding: var(--space-2);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-8px);
    transition:
      opacity var(--motion-fast) var(--easing-standard),
      transform var(--motion-fast) var(--easing-standard),
      visibility var(--motion-fast) var(--easing-standard);
    z-index: 10;
  }

  .header__dropdown.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown-list {
    list-style: none;
  }

  .header__dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--easing-standard);
  }

  .header__dropdown-link:hover {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  /* -------- Right actions -------- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .header__search-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color var(--motion-fast), background-color var(--motion-fast);
  }

  @media (min-width: 768px) {
    .header__search-btn {
      display: flex;
    }
  }

  .header__search-btn:hover {
    color: var(--color-primary-700);
    background: var(--color-primary-100);
  }


  /* -------- Panel pencarian -------- */
  .header__search-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding-block: var(--space-3);
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-interactive);
  }

  .header__search-panel[hidden] {
    display: none;
  }

  .header__search-form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-4);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    max-width: 640px;
    margin-inline: auto;
    color: var(--color-ink-muted);
  }

  .header__search-form:focus-within {
    border-color: var(--color-primary-700);
    box-shadow: 0 0 0 3px rgb(18 64 58 / 0.1);
  }

  .header__search-input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2) 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    background: transparent;
    border: none;
    outline: none;
  }

  .header__search-submit {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: #fff;
    background: var(--color-primary-700);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .header__search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--color-ink-muted);
    cursor: pointer;
  }

  .header__search-close:hover {
    background: var(--color-border);
  }

  .header__search-results {
    max-width: 640px;
    margin: var(--space-2) auto 0;
    list-style: none;
    padding: 0;
  }

  .header__search-results[hidden] {
    display: none;
  }

  .header__search-option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-ink);
    cursor: pointer;
  }

  .header__search-option small {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .header__search-option:hover,
  .header__search-option[aria-selected='true'] {
    background: var(--color-primary-100);
  }

  .header__search-empty {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* Pencarian di drawer mobile */
  .header__drawer-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-4);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .header__drawer-search:focus-within {
    border-color: var(--color-primary-700);
  }

  .header__drawer-search input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2) 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    background: transparent;
    border: none;
    outline: none;
  }

  .header__drawer-search button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-primary-700);
    cursor: pointer;
  }

  /* CTA button */
  .header__cta-btn {
    display: none;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary-700);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--motion-fast) var(--easing-standard),
      transform var(--motion-fast) var(--easing-standard);
  }

  @media (min-width: 768px) {
    .header__cta-btn {
      display: flex;
    }
  }

  .header__cta-btn:hover {
    background: var(--color-primary-900);
    transform: translateY(-1px);
  }

  .header__cta-btn--full {
    width: 100%;
    justify-content: center;
  }

  /* -------- Hamburger -------- */
  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    cursor: pointer;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    transition: background-color var(--motion-fast);
  }

  @media (min-width: 1024px) {
    .header__hamburger {
      display: none;
    }
  }

  .header__hamburger:hover {
    background: var(--color-primary-100);
  }

  .header__hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: var(--radius-pill);
    transition: transform var(--motion-base) var(--easing-standard),
                opacity var(--motion-base) var(--easing-standard);
    transform-origin: center;
  }

  /* Hamburger → X saat open */
  .header__hamburger[aria-expanded="true"] .header__hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header__hamburger[aria-expanded="true"] .header__hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .header__hamburger[aria-expanded="true"] .header__hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* -------- Mobile Drawer -------- */
  .header__drawer {
    position: fixed;
    top: var(--nav-height);
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: var(--color-bg-alt);
    border-left: 1px solid var(--color-border);
    overflow-y: auto;
    padding: var(--space-6);
    z-index: 99;
    transform: translateX(100%);
    transition: transform var(--motion-slow) var(--easing-enter);
  }

  .header__drawer.is-open {
    transform: translateX(0);
  }

  .header__drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .header__drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--motion-fast);
    cursor: pointer;
  }

  .header__drawer-link:hover,
  .header__drawer-link.is-active {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  /* Accordion About mobile */
  .header__drawer-submenu {
    list-style: none;
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    margin-top: var(--space-1);
  }

  .header__drawer-submenu.is-open {
    display: flex;
  }

  .header__drawer-sublink {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color var(--motion-fast), background-color var(--motion-fast);
  }

  .header__drawer-sublink:hover {
    color: var(--color-primary-700);
    background: var(--color-primary-100);
  }

  .header__drawer-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  /* -------- Overlay backdrop -------- */
  .header__overlay {
    display: none;
    position: fixed;
    inset: 0;
    top: var(--nav-height);
    background: rgb(0 0 0 / 0.3);
    z-index: 98;
  }

  .header__overlay.is-open {
    display: block;
  }
</style>

<script>
  // ---- Dropdown "About" (desktop) ----
  const trigger = document.getElementById('about-trigger');
  const dropdown = document.getElementById('about-dropdown');

  if (trigger && dropdown) {
    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      dropdown.classList.toggle('is-open', !isOpen);
    });

    // Tutup saat klik di luar
    document.addEventListener('click', (e) => {
      if (!trigger.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('is-open');
      }
    });

    // Tutup saat Esc (hanya bila dropdown memang terbuka — jangan mencuri fokus)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown.classList.contains('is-open')) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('is-open');
        trigger.focus();
      }
    });
  }

  // ---- Hamburger + Mobile Drawer ----
  const hamburger = document.getElementById('hamburger-btn');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');

  function openDrawer() {
    hamburger?.setAttribute('aria-expanded', 'true');
    hamburger?.setAttribute('aria-label', 'Tutup menu navigasi');
    drawer?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    overlay?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger?.setAttribute('aria-label', 'Buka menu navigasi');
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    overlay?.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    isOpen ? closeDrawer() : openDrawer();
  });

  overlay?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
      closeDrawer();
      hamburger?.focus();
    }
  });

  // ---- Accordion About (mobile) ----
  const mobileAboutTrigger = document.getElementById('mobile-about-trigger');
  const mobileAboutSubmenu = document.getElementById('mobile-about-submenu');

  mobileAboutTrigger?.addEventListener('click', () => {
    const isOpen = mobileAboutTrigger.getAttribute('aria-expanded') === 'true';
    mobileAboutTrigger.setAttribute('aria-expanded', String(!isOpen));
    mobileAboutSubmenu?.classList.toggle('is-open', !isOpen);

    // Putar ikon chevron
    const icon = mobileAboutTrigger.querySelector('.header__dropdown-icon') as SVGElement;
    if (icon) {
      icon.style.transform = !isOpen ? 'rotate(180deg)' : 'rotate(0)';
    }
  });
  // ---- Pencarian top bar ----
  interface SearchItem { name: string; store: string; price: number }

  const searchBtn = document.getElementById('search-btn');
  const searchPanel = document.getElementById('search-panel');
  const searchForm = document.getElementById('header-search-form') as HTMLFormElement | null;
  const searchInput = document.getElementById('header-search-input') as HTMLInputElement | null;
  const searchClose = document.getElementById('search-close');
  const suggestions = document.getElementById('search-suggestions');
  const searchItems: SearchItem[] = JSON.parse(searchPanel?.dataset.items ?? '[]');
  let activeIndex = -1;

  const formatRp = (n: number) => `Rp ${n.toLocaleString('id-ID')}`;

  function openSearch() {
    if (!searchPanel) return;
    searchPanel.hidden = false;
    searchBtn?.setAttribute('aria-expanded', 'true');
    searchInput?.focus();
    renderSuggestions();
  }

  function closeSearch(returnFocus = false) {
    if (!searchPanel || searchPanel.hidden) return;
    searchPanel.hidden = true;
    searchBtn?.setAttribute('aria-expanded', 'false');
    if (returnFocus) searchBtn?.focus();
  }

  function submitSearch(query: string) {
    const q = query.trim();
    // Di halaman Food Nearby: filter langsung. Di halaman lain: pindah ke /?q=...
    if (document.getElementById('food-grid')) {
      window.dispatchEvent(new CustomEvent('safo:search', { detail: { q } }));
      closeSearch();
    } else {
      window.location.href = `/${q ? `?q=${encodeURIComponent(q)}` : ''}#listing`;
    }
  }

  function renderSuggestions() {
    if (!suggestions || !searchInput) return;
    const q = searchInput.value.trim().toLowerCase();
    activeIndex = -1;

    if (!q) {
      suggestions.hidden = true;
      suggestions.innerHTML = '';
      return;
    }

    const found = searchItems
      .filter((i) => `${i.name} ${i.store}`.toLowerCase().includes(q))
      .slice(0, 5);

    suggestions.hidden = false;
    suggestions.innerHTML = '';

    if (found.length === 0) {
      const li = document.createElement('li');
      li.className = 'header__search-empty';
      li.textContent = 'Tidak ada hasil. Tekan Enter untuk tetap mencari.';
      suggestions.appendChild(li);
      return;
    }

    found.forEach((item, i) => {
      const li = document.createElement('li');
      li.className = 'header__search-option';
      li.id = `search-option-${i}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', 'false');
      li.dataset.value = item.name;

      const name = document.createElement('span');
      name.textContent = `${item.name} · ${item.store}`;
      const price = document.createElement('small');
      price.textContent = formatRp(item.price);
      li.append(name, price);

      li.addEventListener('mousedown', (e) => e.preventDefault()); // jaga fokus input
      li.addEventListener('click', () => {
        if (searchInput) searchInput.value = item.name;
        submitSearch(item.name);
      });
      suggestions.appendChild(li);
    });
  }

  function moveActive(delta: number) {
    const options = Array.from(suggestions?.querySelectorAll<HTMLElement>('[role="option"]') ?? []);
    if (options.length === 0) return;
    activeIndex = (activeIndex + delta + options.length) % options.length;
    options.forEach((o, i) => o.setAttribute('aria-selected', String(i === activeIndex)));
    searchInput?.setAttribute('aria-activedescendant', options[activeIndex].id);
  }

  searchBtn?.addEventListener('click', () => {
    searchPanel?.hidden ? openSearch() : closeSearch();
  });
  searchClose?.addEventListener('click', () => closeSearch(true));
  searchInput?.addEventListener('input', renderSuggestions);

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); moveActive(1); }
    if (e.key === 'ArrowUp') { e.preventDefault(); moveActive(-1); }
  });

  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const active = suggestions?.querySelector<HTMLElement>('[aria-selected="true"]');
    const value = active?.dataset.value ?? searchInput?.value ?? '';
    if (active && searchInput) searchInput.value = value;
    submitSearch(value);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchPanel && !searchPanel.hidden) closeSearch(true);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (searchPanel && !searchPanel.hidden && !searchPanel.contains(target) && !searchBtn?.contains(target)) {
      closeSearch();
    }
  });
</script>
