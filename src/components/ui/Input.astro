---
// Input.astro — Search input dengan ikon lokasi
// Used in Hero search bar dan listing filter

interface Props {
  placeholder?: string;
  value?: string;
  id?: string;
  name?: string;
  class?: string;
  type?: 'text' | 'search' | 'email';
  autocomplete?: string;
  'aria-label'?: string;
  'aria-describedby'?: string;
}

const {
  placeholder = 'Cari lokasi (contoh: UNS, Solo)',
  value = '',
  id = 'search-input',
  name = 'search',
  class: className = '',
  type = 'text',
  autocomplete = 'off',
  ...rest
} = Astro.props;
---

<div class={`input-wrapper ${className}`}>
  <!-- Ikon lokasi -->
  <span class="input-icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M9 1.5C6.1 1.5 3.75 3.85 3.75 6.75C3.75 10.6875 9 16.5 9 16.5C9 16.5 14.25 10.6875 14.25 6.75C14.25 3.85 11.9 1.5 9 1.5Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <circle cx="9" cy="6.75" r="1.875" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  </span>

  <input
    type={type}
    id={id}
    name={name}
    placeholder={placeholder}
    value={value}
    autocomplete={autocomplete}
    class="input-field"
    {...rest}
  />

  <!-- Tombol search (submit/action) -->
  <button type="button" class="input-submit" aria-label="Cari">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <circle cx="7.5" cy="7.5" r="5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M11.5 11.5L16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<style>
  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-bg-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    overflow: hidden;
    transition:
      border-color var(--motion-fast) var(--easing-standard),
      box-shadow var(--motion-fast) var(--easing-standard);
  }

  .input-wrapper:focus-within {
    border-color: var(--color-primary-700);
    box-shadow: 0 0 0 3px rgb(18 64 58 / 0.1);
  }

  .input-icon {
    display: flex;
    align-items: center;
    padding-left: var(--space-4);
    color: var(--color-accent);
    flex-shrink: 0;
    pointer-events: none;
  }

  .input-field {
    flex: 1;
    padding: var(--space-3) var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    background: transparent;
    border: none;
    outline: none;
    min-width: 0;
  }

  .input-field::placeholder {
    color: var(--color-ink-muted);
  }

  /* Override reset.css untuk input-field saja */
  .input-field {
    appearance: none;
    -webkit-appearance: none;
  }

  .input-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: var(--space-1);
    background: var(--color-primary-700);
    color: #fff;
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--motion-fast) var(--easing-standard),
      transform var(--motion-fast) var(--easing-standard);
  }

  .input-submit:hover {
    background: var(--color-primary-900);
    transform: scale(1.05);
  }

  .input-submit:focus-visible {
    outline: 2px solid var(--color-primary-700);
    outline-offset: 2px;
  }
</style>
