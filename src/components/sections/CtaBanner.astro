---
// CtaBanner.astro — Section CTA "Yuk Mulai"
// "Selamatkan Makanan, Selamatkan Masa Depan"
// Tombol + app store badges

import Button from '../ui/Button.astro';
---

<section class="cta-banner" aria-labelledby="cta-title">
  <div class="container cta-banner__inner">

    <!-- Ilustrasi kiri -->
    <div class="cta-banner__illustration" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1607349913338-fca6f7fc42d0?w=400&q=80"
        alt=""
        class="cta-banner__img"
        loading="lazy"
        width="300"
        height="360"
      />
    </div>

    <!-- Konten CTA -->
    <div class="cta-banner__content">
      <p class="section-label">Yuk Mulai</p>

      <h2 class="cta-banner__title" id="cta-title">
        Selamatkan Makanan,
        <br />
        <span class="cta-banner__title-accent">Selamatkan Masa Depan</span>
      </h2>

      <div class="cta-banner__actions">
        <Button href="/" variant="primary" size="lg" hasArrow>
          Jelajahi Sekarang
        </Button>

        <!-- App store badges -->
        <div class="cta-banner__stores">
          <a href="/" class="cta-banner__store-btn" aria-label="Download di Google Play Store">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google-play" viewBox="0 0 16 16">
              <path d="M14.222 9.374c1.037-.61 1.037-2.137 0-2.748L11.528 5.04 8.32 8l3.207 2.96zm-3.595 2.116L7.583 8.68 1.03 14.73c.201 1.029 1.36 1.61 2.303 1.055zM1 13.396V2.603L6.846 8zM1.03 1.27l6.553 6.05 3.044-2.81L3.333.215C2.39-.341 1.231.24 1.03 1.27"/>
            </svg>
            GET IT ON <strong>Google Play</strong>
          </a>

          <a href="/" class="cta-banner__store-btn" aria-label="Download di Apple App Store">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-apple" viewBox="0 0 16 16">
              <path d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516s1.52.087 2.475-1.258.762-2.391.728-2.43m3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422s1.675-2.789 1.698-2.854-.597-.79-1.254-1.157a3.7 3.7 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56s.625 1.924 1.273 2.796c.576.984 1.34 1.667 1.659 1.899s1.219.386 1.843.067c.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758q.52-1.185.473-1.282"/>
              <path d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516s1.52.087 2.475-1.258.762-2.391.728-2.43m3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422s1.675-2.789 1.698-2.854-.597-.79-1.254-1.157a3.7 3.7 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56s.625 1.924 1.273 2.796c.576.984 1.34 1.667 1.659 1.899s1.219.386 1.843.067c.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758q.52-1.185.473-1.282"/>
            </svg>
            Download on the <strong>App Store</strong>
          </a>
        </div>
      </div>
    </div>

    <!-- Dekorasi daun kanan -->
    <div class="cta-banner__deco-right" aria-hidden="true">
      <svg viewBox="0 0 80 120" fill="none" aria-hidden="true">
        <path d="M40 115C40 115 5 75 5 38C5 18.67 21.67 3 40 3C58.33 3 75 18.67 75 38C75 75 40 115 40 115Z" fill="var(--color-primary-100)" opacity="0.8"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-12);
    overflow: hidden;
  }

  .cta-banner__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    position: relative;
  }

  @media (min-width: 768px) {
    .cta-banner__inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-10);
    }
  }

  /* -------- Ilustrasi kiri -------- */
  .cta-banner__illustration {
    display: none;
    position: relative;
  }

  @media (min-width: 768px) {
    .cta-banner__illustration {
      display: block;
    }
  }

  .cta-banner__img {
    width: 200px;
    height: 240px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .cta-banner__img {
      width: 260px;
      height: 300px;
    }
  }

  .cta-banner__leaf {
    position: absolute;
    width: 50px;
    top: -20px;
    right: -15px;
    pointer-events: none;
  }

  /* -------- Konten CTA -------- */
  .cta-banner__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .cta-banner__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .cta-banner__title-accent {
    color: var(--color-accent);
  }

  /* Actions */
  .cta-banner__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  /* App store badges */
  .cta-banner__stores {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-banner__store-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-ink);
    color: #fff;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition:
      background-color var(--motion-fast) var(--easing-standard),
      transform var(--motion-fast) var(--easing-standard);
  }

  .cta-banner__store-btn:hover {
    background: var(--color-primary-900);
    transform: translateY(-1px);
  }

  .cta-banner__store-btn strong {
    display: block;
    font-size: var(--text-sm);
  }

  /* -------- Dekorasi kanan -------- */
  .cta-banner__deco-right {
    display: none;
  }

  @media (min-width: 1024px) {
    .cta-banner__deco-right {
      display: block;
      width: 80px;
      opacity: 0.6;
    }
  }
</style>
