---
// CtaBanner.astro — Section CTA "Yuk Mulai"
// "Selamatkan Makanan, Selamatkan Masa Depan"
// Tombol + app store badges

import Button from '../ui/Button.astro';
---

<section class="cta-banner" aria-labelledby="cta-title">
  <div class="container cta-banner__inner">

    <!-- Ilustrasi kiri -->
    <div class="cta-banner__illustration" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1607349913338-fca6f7fc42d0?w=400&q=80"
        alt=""
        class="cta-banner__img"
        loading="lazy"
        width="300"
        height="360"
      />
      <!-- Dekorasi daun -->
      <svg class="cta-banner__leaf" viewBox="0 0 50 68" fill="none" aria-hidden="true">
        <path d="M25 65C25 65 3 43 3 21C3 10.5 12.5 2 25 2C37.5 2 47 10.5 47 21C47 43 25 65 25 65Z" fill="var(--color-primary-500)" opacity="0.6"/>
      </svg>
    </div>

    <!-- Konten CTA -->
    <div class="cta-banner__content">
      <p class="section-label">Yuk Mulai</p>

      <h2 class="cta-banner__title" id="cta-title">
        Selamatkan Makanan,
        <br />
        <span class="cta-banner__title-accent">Selamatkan Masa Depan</span>
      </h2>

      <div class="cta-banner__actions">
        <Button href="/" variant="primary" size="lg" hasArrow>
          Jelajahi Sekarang
        </Button>

        <!-- App store badges -->
        <div class="cta-banner__stores">
          <a href="/" class="cta-banner__store-btn" aria-label="Download di Google Play Store">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.61 1.814C3.228 2.037 3 2.476 3 3v18c0 .524.228.963.61 1.186l.11.065 10.083-10.083v-.236L3.72 1.749l-.11.065zM17.124 13.436l-2.77-2.77-10.07 10.07c.373.347.86.403 1.316.157l11.524-7.457zM17.124 10.564l-11.524-7.457C5.144.85 4.657.907 4.284 1.254l10.07 10.07 2.77-2.76zM18.08 11l-1.02.623v.754l1.02.623 2.9-1.877L18.08 11z"/>
            </svg>
            GET IT ON <strong>Google Play</strong>
          </a>

          <a href="/" class="cta-banner__store-btn" aria-label="Download di Apple App Store">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            Download on the <strong>App Store</strong>
          </a>
        </div>
      </div>
    </div>

    <!-- Dekorasi daun kanan -->
    <div class="cta-banner__deco-right" aria-hidden="true">
      <svg viewBox="0 0 80 120" fill="none" aria-hidden="true">
        <path d="M40 115C40 115 5 75 5 38C5 18.67 21.67 3 40 3C58.33 3 75 18.67 75 38C75 75 40 115 40 115Z" fill="var(--color-primary-100)" opacity="0.8"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-12);
    overflow: hidden;
  }

  .cta-banner__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    position: relative;
  }

  @media (min-width: 768px) {
    .cta-banner__inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-10);
    }
  }

  /* -------- Ilustrasi kiri -------- */
  .cta-banner__illustration {
    display: none;
    position: relative;
  }

  @media (min-width: 768px) {
    .cta-banner__illustration {
      display: block;
    }
  }

  .cta-banner__img {
    width: 200px;
    height: 240px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .cta-banner__img {
      width: 260px;
      height: 300px;
    }
  }

  .cta-banner__leaf {
    position: absolute;
    width: 50px;
    top: -20px;
    right: -15px;
    pointer-events: none;
  }

  /* -------- Konten CTA -------- */
  .cta-banner__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .cta-banner__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .cta-banner__title-accent {
    color: var(--color-accent);
  }

  /* Actions */
  .cta-banner__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  /* App store badges */
  .cta-banner__stores {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-banner__store-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-ink);
    color: #fff;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition:
      background-color var(--motion-fast) var(--easing-standard),
      transform var(--motion-fast) var(--easing-standard);
  }

  .cta-banner__store-btn:hover {
    background: var(--color-primary-900);
    transform: translateY(-1px);
  }

  .cta-banner__store-btn strong {
    display: block;
    font-size: var(--text-sm);
  }

  /* -------- Dekorasi kanan -------- */
  .cta-banner__deco-right {
    display: none;
  }

  @media (min-width: 1024px) {
    .cta-banner__deco-right {
      display: block;
      width: 80px;
      opacity: 0.6;
    }
  }
</style>
