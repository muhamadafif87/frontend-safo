---
// ImpactStats.astro — Angka dampak kumulatif SAFO
// Dipakai di halaman Impact — data dari impact-stats.json

import impactData from '../../data/impact-stats.json';

const { headline } = impactData;

const stats = [
  headline.foodSaved,
  headline.merchantsHelped,
  headline.co2Avoided,
  headline.buyersServed,
];
---

<section class="impact-stats" aria-labelledby="impact-stats-title">
  <div class="container">
    <div class="impact-stats__header">
      <p class="section-label">Dampak Nyata</p>
      <h2 class="impact-stats__title" id="impact-stats-title">
        Setiap pembelian punya<br/>dampak yang terukur
      </h2>
      <p class="impact-stats__desc">
        Angka di bawah ini adalah hasil nyata dari komunitas SAFO —
        pembeli, UMKM, dan platform bekerja bersama mengurangi food waste.
      </p>
    </div>

    <div class="impact-stats__grid">
      {stats.map((stat, i) => (
        <div class="impact-stats__card" style={`--delay: ${i * 0.1}s`}>
          <span class="impact-stats__num">
            {stat.value.toLocaleString('id-ID')}
            <span class="impact-stats__unit">{stat.unit}</span>
          </span>
          <span class="impact-stats__label">{stat.label}</span>
          <p class="impact-stats__desc-small">{stat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact-stats {
    background: var(--color-bg);
    padding-block: var(--space-16) var(--space-20);
  }

  /* Header */
  .impact-stats__header {
    text-align: center;
    margin-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .impact-stats__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  @media (min-width: 768px) {
    .impact-stats__title {
      font-size: clamp(var(--text-2xl), 3vw, 2.5rem);
    }
  }

  .impact-stats__desc {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    max-width: 52ch;
    text-align: center;
    line-height: var(--leading-loose);
  }

  /* Grid stat cards */
  .impact-stats__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .impact-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .impact-stats__card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
    transition:
      box-shadow var(--motion-base) var(--easing-standard),
      border-color var(--motion-base) var(--easing-standard);
  }

  .impact-stats__card:hover {
    box-shadow: var(--shadow-interactive);
    border-color: var(--color-border-strong);
  }

  .impact-stats__num {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-700);
    line-height: 1;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .impact-stats__unit {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink-muted);
    font-family: var(--font-body);
  }

  .impact-stats__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
  }

  .impact-stats__desc-small {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
    max-width: none;
  }
</style>
