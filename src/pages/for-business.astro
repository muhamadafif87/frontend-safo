---
// for-business.astro — Halaman For Business
// Landing untuk UMKM: value prop merchant, cara daftar, testimoni, CTA

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Toast from '../components/ui/Toast.astro';

import impactData from '../data/impact-stats.json';

const { caseStudies } = impactData;

const benefits = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="11" stroke="currentColor" stroke-width="1.5"/><path d="M14 8v6l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: 'Kurangi Makanan Terbuang',
    desc: 'Jual sisa makanan yang masih layak sebelum tutup. Kurangi kerugian dari makanan yang tidak habis terjual.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4C8.477 4 4 8.477 4 14s4.477 10 10 10 10-4.477 10-10S19.523 4 14 4z" stroke="currentColor" stroke-width="1.5"/><path d="M14 10v4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M9 18c0-2 1.5-3 5-3s5 1 5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: 'Tambah Pemasukan Harian',
    desc: 'Setiap porsi yang terjual lewat SAFO adalah pendapatan tambahan di luar omzet normal. Tanpa biaya komisi besar.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M4 20l6-6 4 4 4-5 6 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 4l2 2-10 10-5-5-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity=".3"/></svg>`,
    title: 'Jangkau Pembeli Baru',
    desc: 'Platform SAFO memperkenalkan warungmu ke pembeli yang mungkin belum pernah datang. Bangun pelanggan loyal dari sini.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="4" y="4" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="15" y="4" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="4" y="15" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="15" y="15" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>`,
    title: 'Dashboard Mudah Dipakai',
    desc: 'Upload makanan, kelola pesanan, dan lacak pendapatan lewat dashboard yang sederhana — tidak perlu keahlian teknis.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4C9.582 4 6 7.582 6 12c0 8.25 8 16 8 16s8-7.75 8-16C22 7.582 18.418 4 14 4z" stroke="currentColor" stroke-width="1.5"/><circle cx="14" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/></svg>`,
    title: 'Dikenal Komunitas Lokal',
    desc: 'SAFO menempatkan warungmu di peta, dengan ulasan pembeli nyata. Reputasimu tumbuh bersamaan dengan dampak lingkungan.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4c-1.5 2.5-5 4-5 8a5 5 0 0010 0c0-4-3.5-5.5-5-8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M11 18c0 1.657 1.343 3 3 3s3-1.343 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: 'Berkontribusi ke Lingkungan',
    desc: 'Setiap porsi yang tidak terbuang adalah kontribusi nyata terhadap pengurangan food waste dan emisi gas rumah kaca.',
  },
];

const registerSteps = [
  { num: '01', label: 'Isi formulir daftar online' },
  { num: '02', label: 'Verifikasi oleh tim SAFO (1–2 hari)' },
  { num: '03', label: 'Akses dashboard & mulai upload' },
  { num: '04', label: 'Terima pesanan & nikmati hasilnya' },
];
---

<BaseLayout
  title="For Business — Bergabung Sebagai Mitra SAFO"
  description="Daftar sebagai merchant SAFO dan ubah makanan surplus menjadi pemasukan tambahan. Kurangi food waste, jangkau pembeli baru."
>
  <Fragment slot="header"><Header /></Fragment>

  <!-- Hero -->
  <section class="biz-hero section">
    <div class="container biz-hero__inner">
      <div class="biz-hero__content">
        <p class="section-label">Untuk UMKM</p>
        <h1 class="biz-hero__title">
          Ubah Surplus<br/>Jadi <span class="biz-hero__accent">Pemasukan</span>
        </h1>
        <p class="biz-hero__desc">
          Bergabunglah dengan 143 UMKM kuliner yang sudah mengurangi food waste
          dan menambah pemasukan lewat SAFO. Proses pendaftaran mudah,
          tanpa biaya awal.
        </p>
        <div class="biz-hero__actions">
          <a href="#daftar" class="biz-hero__cta-btn">
            Daftar Sebagai Merchant
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/how-it-works" class="biz-hero__learn-btn">
            Pelajari lebih lanjut
          </a>
        </div>
        <!-- Stats mini -->
        <div class="biz-hero__stats">
          <div class="biz-hero__stat">
            <span class="biz-hero__stat-num">143</span>
            <span class="biz-hero__stat-label">Mitra aktif</span>
          </div>
          <div class="biz-hero__stat-divider" aria-hidden="true"></div>
          <div class="biz-hero__stat">
            <span class="biz-hero__stat-num">0%</span>
            <span class="biz-hero__stat-label">Komisi awal</span>
          </div>
          <div class="biz-hero__stat-divider" aria-hidden="true"></div>
          <div class="biz-hero__stat">
            <span class="biz-hero__stat-num">1–2 hr</span>
            <span class="biz-hero__stat-label">Waktu verifikasi</span>
          </div>
        </div>
      </div>

      <div class="biz-hero__image" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&q=80"
          alt="Pemilik UMKM kuliner mengelola makanan surplus dengan SAFO"
          class="biz-hero__img"
          width="560"
          height="400"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Benefits grid -->
  <section class="biz-benefits section" aria-labelledby="benefits-title">
    <div class="container">
      <div class="biz-benefits__header">
        <p class="section-label">Keuntungan Bergabung</p>
        <h2 class="biz-benefits__title" id="benefits-title">
          Kenapa Bergabung<br/>dengan SAFO?
        </h2>
      </div>

      <div class="biz-benefits__grid">
        {benefits.map((benefit) => (
          <div class="biz-benefit-card">
            <div class="biz-benefit-card__icon" aria-hidden="true">
              <Fragment set:html={benefit.icon} />
            </div>
            <h3 class="biz-benefit-card__title">{benefit.title}</h3>
            <p class="biz-benefit-card__desc">{benefit.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimoni merchant -->
  <section class="biz-testimonials section" aria-labelledby="testimonials-title">
    <div class="container">
      <h2 class="biz-testimonials__title" id="testimonials-title">
        Kata Mitra Kami
      </h2>
      <div class="biz-testimonials__grid">
        {caseStudies.map((study) => (
          <blockquote class="biz-testimonial">
            <p class="biz-testimonial__text">"{study.testimonial}"</p>
            <footer class="biz-testimonial__footer">
              <div class="biz-testimonial__avatar" aria-hidden="true">
                {study.ownerName.charAt(0)}
              </div>
              <div>
                <cite class="biz-testimonial__name">{study.ownerName}</cite>
                <p class="biz-testimonial__role">{study.ownerRole}, {study.name}</p>
                <p class="biz-testimonial__location">{study.location}</p>
              </div>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Cara daftar + form -->
  <section class="biz-register section" id="daftar" aria-labelledby="register-title">
    <div class="container biz-register__inner">
      <!-- Langkah daftar -->
      <div class="biz-register__steps">
        <p class="section-label">Cara Daftar</p>
        <h2 class="biz-register__title" id="register-title">
          4 Langkah Mudah<br/>Mulai Sekarang
        </h2>
        <div class="biz-register__step-list">
          {registerSteps.map((step, i) => (
            <div class="biz-register__step">
              <div class="biz-register__step-num" aria-hidden="true">{step.num}</div>
              <p class="biz-register__step-label">{step.label}</p>
              {i < registerSteps.length - 1 && (
                <div class="biz-register__step-line" aria-hidden="true"></div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Form pendaftaran dummy -->
      <div class="biz-register__form-wrap">
        <h3 class="biz-register__form-title">Daftar Sekarang</h3>
        <p class="biz-register__form-desc">Isi formulir di bawah dan tim kami akan menghubungimu.</p>

        <form class="biz-form" onsubmit="return false;" novalidate aria-label="Formulir pendaftaran merchant SAFO">
          <div class="biz-form__row">
            <div class="biz-form__field">
              <label class="biz-form__label" for="biz-name">Nama Usaha</label>
              <input
                type="text"
                id="biz-name"
                class="biz-form__input"
                placeholder="Contoh: Warung Pak Budi"
                required
              />
            </div>
            <div class="biz-form__field">
              <label class="biz-form__label" for="biz-owner">Nama Pemilik</label>
              <input
                type="text"
                id="biz-owner"
                class="biz-form__input"
                placeholder="Nama lengkap"
                required
              />
            </div>
          </div>

          <div class="biz-form__row">
            <div class="biz-form__field">
              <label class="biz-form__label" for="biz-phone">No. WhatsApp</label>
              <input
                type="tel"
                id="biz-phone"
                class="biz-form__input"
                placeholder="0812-xxxx-xxxx"
                required
              />
            </div>
            <div class="biz-form__field">
              <label class="biz-form__label" for="biz-category">Kategori Utama</label>
              <select id="biz-category" class="biz-form__select" required>
                <option value="">Pilih kategori...</option>
                <option value="makanan-berat">Makanan Berat</option>
                <option value="roti-kue">Roti & Kue</option>
                <option value="minuman">Minuman</option>
                <option value="camilan">Camilan</option>
                <option value="lainnya">Lainnya</option>
              </select>
            </div>
          </div>

          <div class="biz-form__field">
            <label class="biz-form__label" for="biz-location">Alamat Usaha</label>
            <input
              type="text"
              id="biz-location"
              class="biz-form__input"
              placeholder="Kelurahan, Kecamatan, Kota"
              required
            />
          </div>

          <div class="biz-form__field">
            <label class="biz-form__label" for="biz-surplus">Estimasi Sisa Makanan per Hari</label>
            <select id="biz-surplus" class="biz-form__select">
              <option value="">Pilih estimasi...</option>
              <option value="1-5">1–5 porsi</option>
              <option value="5-15">5–15 porsi</option>
              <option value="15-30">15–30 porsi</option>
              <option value="30+">Lebih dari 30 porsi</option>
            </select>
          </div>

          <button type="submit" class="biz-form__submit" id="biz-submit">
            Kirim Pendaftaran
          </button>

          <p class="biz-form__note">
            Dengan mendaftar, kamu menyetujui
            <a href="/terms" class="biz-form__link">syarat & ketentuan</a>
            menjadi mitra SAFO.
          </p>
        </form>
      </div>
    </div>
  </section>

  <Toast />
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
  /* -------- Hero -------- */
  .biz-hero { background: var(--color-bg); }

  .biz-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .biz-hero__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .biz-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .biz-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .biz-hero__accent { color: var(--color-accent); }

  .biz-hero__desc {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: var(--leading-loose);
    max-width: 50ch;
  }

  .biz-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .biz-hero__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color var(--motion-fast), transform var(--motion-fast);
  }

  .biz-hero__cta-btn:hover {
    background: var(--color-accent-strong);
    transform: translateY(-1px);
  }

  .biz-hero__cta-btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  .btn__arrow {
    display: inline-block;
    transition: transform var(--motion-fast) var(--easing-standard);
  }

  .biz-hero__learn-btn {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-700);
    text-decoration: none;
    transition: color var(--motion-fast);
  }

  .biz-hero__learn-btn:hover {
    color: var(--color-primary-900);
    text-decoration: underline;
  }

  .biz-hero__stats {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .biz-hero__stat {
    display: flex;
    flex-direction: column;
  }

  .biz-hero__stat-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-700);
    line-height: 1;
  }

  .biz-hero__stat-label {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .biz-hero__stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }

  .biz-hero__image { display: flex; justify-content: center; }

  .biz-hero__img {
    width: 100%;
    max-width: 480px;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* -------- Benefits -------- */
  .biz-benefits {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .biz-benefits__header {
    margin-bottom: var(--space-10);
  }

  .biz-benefits__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-2);
    line-height: var(--leading-tight);
  }

  .biz-benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 600px) {
    .biz-benefits__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1024px) {
    .biz-benefits__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .biz-benefit-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: box-shadow var(--motion-base), border-color var(--motion-base);
  }

  .biz-benefit-card:hover {
    box-shadow: var(--shadow-interactive);
    border-color: var(--color-border-strong);
  }

  .biz-benefit-card__icon {
    width: 48px;
    height: 48px;
    background: var(--color-primary-100);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-700);
  }

  .biz-benefit-card__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    line-height: var(--leading-snug);
  }

  .biz-benefit-card__desc {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
    max-width: none;
  }

  /* -------- Testimoni -------- */
  .biz-testimonials {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .biz-testimonials__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-8);
  }

  .biz-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .biz-testimonials__grid { grid-template-columns: 1fr 1fr; }
  }

  .biz-testimonial {
    padding: var(--space-6);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary-700);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .biz-testimonial__text {
    font-size: var(--text-base);
    color: var(--color-ink);
    font-style: italic;
    line-height: var(--leading-loose);
    max-width: none;
  }

  .biz-testimonial__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .biz-testimonial__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-primary-100);
    color: var(--color-primary-700);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .biz-testimonial__name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    font-style: normal;
  }

  .biz-testimonial__role,
  .biz-testimonial__location {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    max-width: none;
  }

  /* -------- Register section -------- */
  .biz-register {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .biz-register__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .biz-register__inner { grid-template-columns: 1fr 1.5fr; }
  }

  .biz-register__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .biz-register__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .biz-register__step-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .biz-register__step {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    position: relative;
    padding-bottom: var(--space-6);
  }

  .biz-register__step:last-child {
    padding-bottom: 0;
  }

  .biz-register__step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-primary-700);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .biz-register__step-label {
    font-size: var(--text-base);
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
    max-width: none;
  }

  .biz-register__step-line {
    position: absolute;
    left: 19px;
    top: 40px;
    width: 2px;
    height: var(--space-6);
    background: var(--color-border);
    z-index: 0;
  }

  /* Form pendaftaran */
  .biz-register__form-wrap {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .biz-register__form-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .biz-register__form-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: none;
  }

  .biz-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .biz-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .biz-form__row { grid-template-columns: 1fr 1fr; }
  }

  .biz-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .biz-form__label {
