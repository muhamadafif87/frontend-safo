---
// LegalLayout.astro — Layout halaman legal (Privacy Policy, Terms & Conditions)
// Konten diberikan sebagai data `sections`; nomor & daftar isi dibuat otomatis.

import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Toast from '../components/ui/Toast.astro';

interface Section {
  id: string;
  heading: string;
  paragraphs?: string[];
  items?: string[];
}

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  updated: string;
  sections: Section[];
}

const { title, eyebrow, description, updated, sections } = Astro.props;
---

<BaseLayout title={`${title} — SAFO`} description={description}>
  <Fragment slot="header"><Header /></Fragment>

  <section class="legal section">
    <div class="container">
      <header class="legal__header">
        <p class="section-label">{eyebrow}</p>
        <h1 class="legal__title">{title}</h1>
        <p class="legal__meta">Terakhir diperbarui: {updated}</p>
      </header>

      <p class="legal__notice" role="note">
        <strong>Dokumen contoh.</strong> Isi halaman ini masih berupa draf placeholder dan belum
        ditinjau secara hukum. Versi resmi akan menggantikannya sebelum SAFO diluncurkan.
      </p>

      <div class="legal__layout">
        <nav class="legal__toc" aria-label="Daftar isi">
          <p class="legal__toc-title">Daftar isi</p>
          <ol>
            {sections.map((section) => (
              <li><a href={`#${section.id}`}>{section.heading}</a></li>
            ))}
          </ol>
        </nav>

        <div class="legal__content">
          {sections.map((section, i) => (
            <section class="legal__section" id={section.id} aria-labelledby={`${section.id}-title`}>
              <h2 class="legal__heading" id={`${section.id}-title`}>
                <span class="legal__num" aria-hidden="true">{i + 1}</span>
                {section.heading}
              </h2>
              {section.paragraphs?.map((text) => <p>{text}</p>)}
              {section.items && (
                <ul>
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Toast />
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
  .legal {
    background: var(--color-bg);
  }

  .legal__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .legal__title {
    font-family: var(--font-display);
    font-size: clamp(1.9375rem, 4vw, 2.75rem);
    color: var(--color-ink);
    line-height: var(--leading-tight);
  }

  .legal__meta {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .legal__notice {
    max-width: none;
    margin-bottom: var(--space-10);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink);
    background: var(--color-accent-light);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .legal__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .legal__layout {
      grid-template-columns: 240px minmax(0, 720px);
      gap: var(--space-12);
      align-items: start;
    }
  }

  /* Daftar isi: sticky di desktop */
  .legal__toc {
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 1024px) {
    .legal__toc {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-6));
    }
  }

  .legal__toc-title {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .legal__toc ol {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .legal__toc a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .legal__toc a:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Konten */
  .legal__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .legal__section {
    scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .legal__heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    line-height: var(--leading-snug);
  }

  .legal__num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-primary-100);
    color: var(--color-primary-700);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
  }

  .legal__section p {
    max-width: none;
    margin-bottom: var(--space-3);
    color: var(--color-ink-muted);
    line-height: var(--leading-loose);
  }

  .legal__section ul {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
  }
</style>
